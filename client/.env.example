# ==============================================================================
# GANESH COMPUTERS & ACCESSORIES - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Project Credentials
# Obtain these from: https://supabase.com/dashboard/project/<your-project-id>/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# WhatsApp Business Integration
# Direct WhatsApp phone number with country code without spaces or symbols (e.g., +919876543210)
VITE_WHATSAPP_PHONE=+919876543210
